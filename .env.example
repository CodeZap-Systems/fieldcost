# ============================================================
# FieldCost Environment Variables — SAFE TEMPLATE
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ----------------------------------------------------------
# Supabase (required)
# ----------------------------------------------------------
# Public project URL — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Public anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Service role key — SERVER-SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>

# ----------------------------------------------------------
# App URL (required for OAuth redirects and email links)
# ----------------------------------------------------------
# Production: https://fieldcost.vercel.app  (or your custom domain)
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------
# Microsoft Entra ID / Azure AD (optional — for SSO)
# Configure in Supabase Dashboard → Auth → Providers → Azure
# Then paste the callback URL from Supabase into your Entra app registration.
# ----------------------------------------------------------
# AZURE_AD_TENANT_ID=<your-tenant-id>
# AZURE_AD_CLIENT_ID=<your-client-id>
# AZURE_AD_CLIENT_SECRET=<your-client-secret>

# ----------------------------------------------------------
# Sentry (optional — error tracking)
# ----------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_AUTH_TOKEN=<your-sentry-auth-token>
# SENTRY_ORG=<your-sentry-org>
# SENTRY_PROJECT=<your-sentry-project>

# ----------------------------------------------------------
# Beta access gate (set to "true" to enable the gate)
# When enabled, only users in the beta_access table can access the app.
# See BETA_ACCESS.md for how to grant access.
# ----------------------------------------------------------
# BETA_GATING=true

# ----------------------------------------------------------
# Environment flag (used by ops scripts to prevent running
# against production — must be "staging" for seed/ops scripts)
# ----------------------------------------------------------
# ENVIRONMENT=staging

# ----------------------------------------------------------
# Demo mode flag (must be "true" to run seeding scripts)
# ----------------------------------------------------------
# DEMO_MODE=true

# ----------------------------------------------------------
# Staging Supabase project (separate project for staging)
# ----------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL_STAGING=https://<staging-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGING=sb_publishable_<staging-anon-key>
# SUPABASE_SERVICE_ROLE_KEY_STAGING=sb_secret_<staging-service-role-key>
